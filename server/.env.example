# New API 数据库连接
# MySQL 格式:
DATABASE_URL="mysql://用户名:密码@IP地址:3306/数据库名"
# PostgreSQL 格式:
# DATABASE_URL="postgresql://用户名:密码@IP地址:5432/数据库名"

# 服务端口
PORT=3001

# Web 登录密码
ACCESS_PASSWORD=your_password

# Telegram 通知 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 额度转美元单位（与 new-api 的 QuotaPerUnit 保持一致，默认 500000）
QUOTA_PER_UNIT=500000

# 最大监控模型数量（默认 50）
MAX_MONITOR_MODELS=50
