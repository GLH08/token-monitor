# Token Monitor 环境配置模板
# 复制此文件重命名为 .env，并修改内部参数

# ================================
# 数据库配置 (必须项)
# ================================
# 连接至 New API 的同源数据库。支持 MySQL 或 PostgreSQL。
# MySQL 格式示例: mysql://username:password@127.0.0.1:3306/new_api
# PostgreSQL 格式示例: postgresql://username:password@127.0.0.1:5432/new_api?schema=public
DATABASE_URL=mysql://root:123456@172.17.0.1:3306/new_api

# ================================
# 访问凭据设定 (可选项)
# ================================
# 配置后，访问 Token Monitor 面板的主页需要输入此密码进行身份签发。
# 留空：默认不启用密码，直接开放面板访问
ACCESS_PASSWORD=admin123

# ================================
# Telegram 推送通知 (可选项)
# ================================
# Telegram 机器人的 Token (通过 @BotFather 申请)
TELEGRAM_BOT_TOKEN=
# 接收警告信息的 Telegram 会话 ID (即你的用户 ID 或群组 ID)
TELEGRAM_CHAT_ID=

# ================================
# 系统偏好 (可选项)
# ================================
# New API 额度单位转 Dollar 或其他货币的比率倍数。
# 默认 500000 即 50 万额度 = 1 美元。这与新老 API 的默认参数保持一致
QUOTA_PER_UNIT=500000

# 控制面板首页「模型排行榜」中最多显示的纵列数（过多容易导致图表折叠）
MAX_MONITOR_MODELS=50
DATA_RETENTION_DAYS=90
MAX_MONITOR_MODELS=50